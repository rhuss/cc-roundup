#!/usr/bin/env python3
"""Fake clipboard tool for tests (pbcopy / slack-pbcopy). Never touches the real clipboard.

Logs {"tool": <basename>, "argv", "stdin"} to $ROUNDUP_STUB_LOG and exits 0.
"""
import json
import os
import sys


def main():
    stdin = "" if sys.stdin.isatty() else sys.stdin.read()
    path = os.environ.get("ROUNDUP_STUB_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(
                json.dumps(
                    {"tool": os.path.basename(sys.argv[0]), "argv": sys.argv[1:], "stdin": stdin}
                )
                + "\n"
            )
    return 0


if __name__ == "__main__":
    sys.exit(main())
