#!/usr/bin/env python3
"""Fake `gh` for tests. Never touches the network.

Logs argv like the corgi stub. `gh auth status` exits with
$ROUNDUP_STUB_GH_AUTH (default 0). `gh pr view <url> --json ...` answers from
$ROUNDUP_STUB_FIXTURES/gh/<owner>-<repo>-<n>.json; a missing file exits 1
with a GraphQL error like the real tool.
"""
import json
import os
import re
import sys


def main():
    argv = sys.argv[1:]
    path = os.environ.get("ROUNDUP_STUB_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"tool": "gh", "argv": argv, "stdin": ""}) + "\n")
    if argv[:2] == ["auth", "status"]:
        code = int(os.environ.get("ROUNDUP_STUB_GH_AUTH", "0"))
        if code:
            sys.stderr.write("You are not logged into any GitHub hosts.\n")
        return code
    if argv[:2] == ["pr", "view"] and len(argv) > 2:
        m = re.match(r"https://github\.com/([^/]+)/([^/]+)/pull/(\d+)$", argv[2])
        if not m:
            sys.stderr.write("invalid PR url\n")
            return 1
        fixture = os.path.join(
            os.environ.get("ROUNDUP_STUB_FIXTURES", ""), "gh", "%s-%s-%s.json" % m.groups()
        )
        if not os.path.exists(fixture):
            sys.stderr.write(
                "GraphQL: Could not resolve to a PullRequest with the number of %s.\n" % m.group(3)
            )
            return 1
        with open(fixture, encoding="utf-8") as fh:
            sys.stdout.write(fh.read())
        return 0
    sys.stderr.write("stub gh: unsupported %r\n" % (argv,))
    return 2


if __name__ == "__main__":
    sys.exit(main())
